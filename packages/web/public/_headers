# Production response-header template for Netlify and Cloudflare Pages.
# Other hosts must translate these values into their own reverse-proxy config.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://accounts.google.com https://*.gstatic.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com https://challenges.cloudflare.com; child-src 'none'; worker-src 'self'; media-src 'none'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
