{
  "name": "@rice-mill/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite --config ../web/vite.config.ts --port 8448",
    "dev:electron": "wait-on http://localhost:8448 && npm run build:main && electron .",
    "build:main": "tsc -p tsconfig.json",
    "build": "npm run build:web && npm run build:main && electron-builder",
    "build:web": "cd ../web && npm run build"
  },
  "dependencies": {
    "@rice-mill/shared": "*",
    "better-sqlite3": "^11.7.0",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "concurrently": "^10.0.3",
    "electron": "42.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ricemillsystem.app",
    "productName": "Rice Mill System",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "../web/dist/**/*"
    ]
  }
}
