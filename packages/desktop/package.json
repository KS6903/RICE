{
  "name": "@rice-mill/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite --config ../web/vite.config.ts --port 8448",
    "dev:electron": "wait-on http://localhost:8448 && npm run build:main && electron .",
    "build:main": "tsc -p tsconfig.json",
    "build": "node scripts/build-desktop.mjs",
    "build:web": "cd ../web && npm run build",
    "test": "vitest run",
    "smoke": "node scripts/run-smoke.cjs"
  },
  "dependencies": {
    "axios": "1.21.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "electron": "44.9.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ricemillsystem.app",
    "productName": "Rice Mill System",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "../web/public/icon-512.png"
    },
    "files": [
      "main/**/*.js",
      "main/build-config.json",
      "preload/**/*.js"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "npmRebuild": false
  }
}
