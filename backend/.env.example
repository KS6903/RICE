# PostgreSQL connection — match your pgAdmin 4 "Rice Mill System" database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/RiceMillSystem
# The API process is always DML-only in production.
PROCESS_ROLE=api
RUNTIME_DATABASE_ROLE=ricemill_app
# Worker/migration environment only (never expose this variable to the API):
# PROCESS_ROLE=provisioner
# PROVISIONER_DATABASE_URL=postgresql://ricemill_provisioner:password@db:5432/RiceMillSystem?sslmode=require

# JWT secret — generate with: openssl rand -hex 32  (MUST be 32+ random chars in prod)
SECRET_KEY=change_me_generate_a_long_random_secret_key
ALGORITHM=HS256
JWT_ISSUER=oryza-api
JWT_AUDIENCE=oryza-clients
# Separate from SECRET_KEY in production; generate with: openssl rand -hex 32
# MFA_ENCRYPTION_KEY=
# Required for public registration in production (16+ random characters).
# SIGNUP_INVITE_CODE=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Deployment environment: "dev" or "prod". ENV=prod turns on fail-closed config
# checks (rejects weak SECRET_KEY, DEBUG=true, localhost origins, COOKIE_SECURE=false)
# and enables HSTS.
ENV=dev

# CORS — comma-separated allowed origins (no localhost in prod)
ALLOWED_ORIGINS=http://localhost:8448,http://localhost:3000

# Host header allowlist for TrustedHostMiddleware. "*" for dev; in prod set an
# explicit comma-separated list of your domains, e.g. api.example.com
TRUSTED_HOSTS=*

# Session cookies: keep false on http://localhost; MUST be true in prod (HTTPS).
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Rate limiting (slowapi). Backed by Redis when REDIS_URL is set; falls back to
# in-memory. Leave RATE_LIMIT_DEFAULT empty to disable the global per-IP throttle.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=1000/minute
RATE_LIMIT_AUTH=10/minute
# Only enable behind a reverse proxy you control. Then the real client IP is read
# from X-Forwarded-For, counting FORWARDED_HOPS entries from the right (= number
# of proxies in front of the app). Leave off when the app faces clients directly.
RATE_LIMIT_TRUST_FORWARDED_FOR=false
RATE_LIMIT_FORWARDED_HOPS=1
# Progressive account lockout (Redis-backed; no-op without Redis). Failures within
# LOGIN_LOCKOUT_WINDOW_SECONDS that reach the (shrinking) threshold lock the account
# for a (growing) duration; after LOGIN_LOCKOUT_MAX_ROUNDS lockouts it is permanently
# locked until the user resets their password.
LOGIN_MAX_FAILURES=5
LOGIN_MIN_FAILURES=2
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_FACTOR=5
LOGIN_LOCKOUT_MAX_SECONDS=86400
LOGIN_LOCKOUT_MAX_ROUNDS=5
LOGIN_LOCKOUT_ROUND_TTL_SECONDS=86400
LOGIN_LOCKOUT_PERMANENT_TTL_SECONDS=2592000

# MFA enforcement. When true, accounts in MFA_REQUIRED_ROLES (plus all platform
# admins) must enroll in TOTP before the API will serve data endpoints.
MFA_ENFORCE=true
MFA_REQUIRED_ROLES=owner,admin

# Breached-password check (HIBP k-anonymity) on signup/password change.
# Best-effort: skipped automatically when offline. Recommended true in prod.
PASSWORD_BREACH_CHECK=false

# Password reset and email verification. Production requires verification and
# SMTP delivery; account links are never written to application logs.
PASSWORD_RESET_TOKEN_MINUTES=30
EXPOSE_RESET_TOKEN=false
FRONTEND_BASE_URL=http://localhost:8448
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_HOURS=48

# Mandatory when ENV=prod.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=security@example.com
SMTP_STARTTLS=true

# App
APP_NAME=Rice Mill System
DEBUG=false

# Google OAuth — paste your Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# DeepSeek API key (optional) — powers the Enterprise-only palay Drying Advisor.
# Without it the /drying-advisory endpoint responds "not configured" (501); no
# other feature depends on this.
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
RATE_LIMIT_DRYING_ADVISOR=10/hour

# Redis cache (optional). Start one with:  docker compose up -d redis
# If Redis is down or this is blank, the app falls back to PostgreSQL automatically.
REDIS_URL=redis://localhost:6379/0
