# Runtime dependencies: the input to pip-compile. Edit this file, then regenerate
# the hash-pinned lock, requirements.txt, under Python 3.11 (.python-version):
#   pip-compile --generate-hashes --strip-extras --output-file=requirements.txt requirements.in
# CI fails when a pin here and the lock disagree (scripts/check_lockfiles.py).
#
# Pins refreshed by the security hardening pass (pip-audit clean as of 2026-06):
# fastapi/starlette, python-multipart, python-dotenv bumped past known CVEs.
fastapi==0.151.0
# uvicorn's [standard] extras, listed one by one instead of via the extra:
# the extra adds uvloop on Linux only, and pip-compile drops platform
# markers, so a lock compiled on Linux (Dependabot, CI) listed uvloop and the
# install failed on Windows, where uvloop can't build. Production has never
# had uvloop (the lock was compiled on Windows), so leaving it out keeps the
# runtime exactly as it was: asyncio's own event loop.
uvicorn==0.54.0
httptools==0.9.0
websockets==16.1
watchfiles==1.3.0
pyyaml==6.0.3
sqlalchemy==2.1.5
alembic==1.20.0
psycopg[binary]==3.3.6
# Security hardening P2.13: python-jose (CVE-2024-33663/33664) → PyJWT, and the
# unmaintained passlib → direct bcrypt. Stored $2b$ hashes verify unchanged.
PyJWT==2.15.1
cryptography==50.0.2  # JWT alg backends + Fernet (core/crypto.py for MFA seeds); PYSEC-2026-3552 fix
