# =============================================================================
# Production env template — API service  (PROCESS_ROLE=api)
# Companion to ../../PRODUCTION_LAUNCH_CHECKLIST.md  (Phase 2).
#
# HOW TO USE
#   1. Copy this to a NON-committed candidate file, e.g.  api.env
#   2. Replace every __PLACEHOLDER__ and example.com value with the real thing.
#   3. Validate (from backend/):
#        .\.venv\Scripts\python.exe check_production_config.py deploy\api.env
#      Expect: "Production configuration passed all fail-closed checks."
#   4. Move the values into your hosting provider's secret manager.
#   5. Securely delete the candidate file. NEVER commit real values.
#
# Only keys the prod validator enforces are listed; everything else in
# app/core/config.py keeps its safe default. Booleans are lowercase true/false.
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
ENV=prod
DEBUG=false

# ── Process role ─────────────────────────────────────────────────────────────
# The long-running API. It must NEVER see PROVISIONER_DATABASE_URL — the app
# refuses to boot when PROCESS_ROLE=api and that variable is present.
PROCESS_ROLE=api

# ── Database: runtime, DML-only ──────────────────────────────────────────────
# A data-only role created by scripts/db_least_privilege.sql (Phase 1).
# TLS is mandatory: the URL must contain sslmode=require (or stricter).
# Match the URL scheme your app already uses (e.g. postgresql:// as in e2e).
RUNTIME_DATABASE_ROLE=ricemill_app
DATABASE_URL=postgresql://ricemill_app:__DB_PASSWORD__@db.example.com:5432/ricemill?sslmode=require
# Do NOT add PROVISIONER_DATABASE_URL to the API config.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate with:  .\.venv\Scripts\python.exe generate_security_secrets.py --output FILE
# Paste here only long enough to validate, then move to the secret manager and
# delete both files. SECRET_KEY/MFA_ENCRYPTION_KEY >=32 chars, SIGNUP >=16.
SECRET_KEY=__PASTE_FROM_SECRET_GENERATOR__
MFA_ENCRYPTION_KEY=__PASTE_FROM_SECRET_GENERATOR__
SIGNUP_INVITE_CODE=__PASTE_FROM_SECRET_GENERATOR__

# ── HTTPS surface (real https:// only — no localhost, no "*") ────────────────
ALLOWED_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com,api.example.com
FRONTEND_BASE_URL=https://app.example.com
COOKIE_SECURE=true
COOKIE_DOMAIN=example.com

# ── Auth hardening (prod-required) ───────────────────────────────────────────
EXPOSE_RESET_TOKEN=false
RATE_LIMIT_ENABLED=true
MFA_ENFORCE=true
MFA_REQUIRED_ROLES=owner,admin
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_BREACH_CHECK=true

# ── Behind a reverse proxy / load balancer (Phase 6) ─────────────────────────
# Enable ONLY when the API runs behind a proxy you control, so rate limits and
# lockouts key off the real client IP. HOPS = number of proxies in front of you.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
RATE_LIMIT_FORWARDED_HOPS=1

# ── Email (required in prod; password via secret manager) ────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USERNAME=__SMTP_USERNAME__
SMTP_PASSWORD=__PASTE_FROM_SECRET_MANAGER__

# ── Redis (required in prod, TLS only — rediss://) ───────────────────────────
REDIS_URL=rediss://:__REDIS_PASSWORD__@redis.example.com:6379/0

# ── Optional integrations (leave unset to disable) ───────────────────────────
# GOOGLE_CLIENT_ID=__OAUTH_CLIENT_ID__       # Google sign-in (prod origins/redirects)
# GOOGLE_WEATHER_API_KEY=__KEY__             # weather widget (else Open-Meteo)
# DEEPSEEK_API_KEY=__KEY__                   # Enterprise Drying Advisor (501 when unset)
# DEEPSEEK_AUTOMATIONS_API_KEY=__KEY__       # Enterprise AI automations (falls back to DEEPSEEK_API_KEY)
