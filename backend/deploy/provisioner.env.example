# =============================================================================
# Production env template — Provisioning worker  (PROCESS_ROLE=provisioner)
# Companion to ../../PRODUCTION_LAUNCH_CHECKLIST.md  (Phase 2 + Phase 5).
#
# Runs `provision_pending_tenants.py --watch` and the migrations. It is the ONLY
# process that holds PROVISIONER_DATABASE_URL. Keep it in a separate service
# identity/container from the API.
#
# HOW TO USE — same as the API template:
#   1. Copy to a NON-committed candidate file, e.g.  provisioner.env
#   2. Replace every __PLACEHOLDER__ / example.com value.
#   3. Validate:  .\.venv\Scripts\python.exe check_production_config.py deploy\provisioner.env
#   4. Move values into the secret manager; delete the candidate file.
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
ENV=prod
DEBUG=false

# ── Process role ─────────────────────────────────────────────────────────────
PROCESS_ROLE=provisioner

# ── Database: runtime (same DML-only role/URL as the API) ────────────────────
RUNTIME_DATABASE_ROLE=ricemill_app
DATABASE_URL=postgresql://ricemill_app:__DB_PASSWORD__@db.example.com:5432/ricemill?sslmode=require

# ── Database: provisioner (owner/DDL role) ───────────────────────────────────
# REQUIRED for this role. MUST be a DIFFERENT database role from DATABASE_URL
# above (owns objects, runs migrations + tenant schema creation). TLS mandatory.
PROVISIONER_DATABASE_URL=postgresql://ricemill_owner:__OWNER_PASSWORD__@db.example.com:5432/ricemill?sslmode=require

# ── Secrets (same three as the API; via secret manager) ──────────────────────
SECRET_KEY=__PASTE_FROM_SECRET_GENERATOR__
MFA_ENCRYPTION_KEY=__PASTE_FROM_SECRET_GENERATOR__
SIGNUP_INVITE_CODE=__PASTE_FROM_SECRET_GENERATOR__

# ── HTTPS surface (validator runs for every process; keep these consistent) ──
ALLOWED_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com,api.example.com
FRONTEND_BASE_URL=https://app.example.com
COOKIE_SECURE=true
COOKIE_DOMAIN=example.com

# ── Auth hardening (prod-required) ───────────────────────────────────────────
EXPOSE_RESET_TOKEN=false
RATE_LIMIT_ENABLED=true
MFA_ENFORCE=true
MFA_REQUIRED_ROLES=owner,admin
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_BREACH_CHECK=true

# ── Email (required in prod; password via secret manager) ────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USERNAME=__SMTP_USERNAME__
SMTP_PASSWORD=__PASTE_FROM_SECRET_MANAGER__

# ── Redis (required in prod, TLS only — rediss://) ───────────────────────────
REDIS_URL=rediss://:__REDIS_PASSWORD__@redis.example.com:6379/0
