# Dev/test-only dependencies: the input to pip-compile, on top of the runtime set.
# Regenerate the hash-pinned lock under Python 3.11 (.python-version):
#   pip-compile --allow-unsafe --generate-hashes --strip-extras --output-file=requirements-dev.txt requirements-dev.in
# Install with:
#   .venv/Scripts/python -m pip install --require-hashes -r requirements-dev.txt
-r requirements.in

