packages/desktop/main/build-config.json
release/

# SQLite local databases
*.db
*.sqlite
*.sqlite3
# SQLite may leave journal sidecars next to a local database after a crash or
# while WAL mode is active. These can contain the same sensitive offline data.
*.db-journal
*.db-shm
*.db-wal
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Python
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# TypeScript / Vite incremental caches
*.tsbuildinfo
.vite/

# Playwright test artifacts
test-results/
playwright-report/

# Cloudflare / Wrangler local state
.wrangler/
.dev.vars
.dev.vars.*

# Vite/Vitest config bundles written next to the config on each run
*.timestamp-*.mjs
