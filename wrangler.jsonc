{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oryza",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The built SPA. run_worker_first keeps /api/* and /ws/* out of the asset
  // handler; everything else falls back to index.html for client-side routing.
  "assets": {
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },

  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./backend/Dockerfile",
      // Repo root, not backend/, so the image can carry legal/ as well. The
      // root .dockerignore keeps the context small.
      "image_build_context": "./",
      "instance_type": "standard-1",
      // Keep in step with the API_INSTANCES var the Worker balances across.
      "max_instances": 3
    },
    {
      "class_name": "ProvisionerContainer",
      "image": "./backend/Dockerfile",
      "image_build_context": "./",
      "instance_type": "basic",
      "max_instances": 1
    },
    {
      // Scheduled jobs (backend/app/jobs), started by the cron trigger below.
      "class_name": "JobsContainer",
      "image": "./backend/Dockerfile",
      "image_build_context": "./",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "API_CONTAINER", "class_name": "ApiContainer" },
      { "name": "PROVISIONER_CONTAINER", "class_name": "ProvisionerContainer" },
      { "name": "JOBS_CONTAINER", "class_name": "JobsContainer" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApiContainer", "ProvisionerContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["JobsContainer"]
    }
  ],

  // Every 15 minutes: the provisioner drains queued tenant schemas, and the
  // jobs runner runs whatever scheduled work is due (worker/index.ts).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  // Non-secret configuration. Replace example.com with the real domain before
  // deploying. Secrets are set with `wrangler secret put` — never listed here.
  "vars": {
    // How many API instances the Worker load-balances stateless /api/* across.
    // Must not exceed the ApiContainer max_instances above.
    "API_INSTANCES": "3",
    "RUNTIME_DATABASE_ROLE": "ricemill_app",
    // TODO(deploy): replace with the real host once one exists. On workers.dev
    // these are "oryza.<subdomain>.workers.dev".
    "ALLOWED_ORIGINS": "https://app.example.com",
    "TRUSTED_HOSTS": "app.example.com",
    "FRONTEND_BASE_URL": "https://app.example.com",
    // Empty on a *.workers.dev host: workers.dev is on the Public Suffix List, so
    // a Domain attribute naming it is rejected and the session cookie is dropped.
    // Set this only for a real domain you own (e.g. "oryza.ph").
    "COOKIE_DOMAIN": "",
    "MFA_REQUIRED_ROLES": "owner,admin",
    "SMTP_HOST": "smtp.example.com",
    "SMTP_PORT": "587",
    "SMTP_FROM_EMAIL": "no-reply@example.com",
    "SMTP_USERNAME": "no-reply@example.com"
  },

  // ── The private preview (`wrangler deploy --env preview`) ──────────────────
  // A test site for invited testers on app.oraiza.workers.dev,
  // behind Cloudflare Access. Trimmed to stay near the Workers Paid plan's
  // included container hours: one small API container that sleeps after 10
  // minutes, and no 15-minute cron (it would wake the provisioner and the jobs
  // runner about 96 times a day). Signups still start the provisioner on their
  // own (X-Provisioning-Queued); scheduled jobs don't run here.
  // Every binding is spelled out rather than inherited. See PREVIEW_DEPLOY.md.
  "env": {
    "preview": {
      // The Worker is "app", so the site is app.oraiza.workers.dev.
      "name": "app",
      // Every container stays in Asia-Pacific, next to the Neon database and
      // Upstash Redis in Singapore. Unpinned, one can start far away, and then
      // each query crosses an ocean.
      "containers": [
        {
          "class_name": "ApiContainer",
          "image": "./backend/Dockerfile",
          "image_build_context": "./",
          "instance_type": "basic",
          "max_instances": 1,
          "constraints": { "regions": ["APAC"] }
        },
        {
          "class_name": "ProvisionerContainer",
          "image": "./backend/Dockerfile",
          "image_build_context": "./",
          "instance_type": "basic",
          "max_instances": 1,
          "constraints": { "regions": ["APAC"] }
        },
        {
          "class_name": "JobsContainer",
          "image": "./backend/Dockerfile",
          "image_build_context": "./",
          "instance_type": "basic",
          "max_instances": 1,
          "constraints": { "regions": ["APAC"] }
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "API_CONTAINER", "class_name": "ApiContainer" },
          { "name": "PROVISIONER_CONTAINER", "class_name": "ProvisionerContainer" },
          { "name": "JOBS_CONTAINER", "class_name": "JobsContainer" }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ApiContainer", "ProvisionerContainer"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["JobsContainer"]
        }
      ],
      "triggers": {
        "crons": []
      },
      "observability": {
        "enabled": true
      },
      "vars": {
        // ENV=preview for every container (worker/container-env.json "targets").
        "DEPLOY_TARGET": "preview",
        "API_INSTANCES": "1",
        "API_SLEEP_AFTER": "10m",
        "RUNTIME_DATABASE_ROLE": "ricemill_app",
        // "oraiza" is the account's workers.dev subdomain (Workers & Pages,
        // right-hand side of the overview).
        "ALLOWED_ORIGINS": "https://app.oraiza.workers.dev",
        "TRUSTED_HOSTS": "app.oraiza.workers.dev",
        "FRONTEND_BASE_URL": "https://app.oraiza.workers.dev",
        "COOKIE_DOMAIN": "",
        "MFA_REQUIRED_ROLES": "owner,admin",
        // Email is optional here. Leave these empty for none (links are not sent,
        // and verification is off), or fill in a Gmail address with an app
        // password (SMTP_PASSWORD as a secret).
        "SMTP_HOST": "",
        "SMTP_PORT": "587",
        "SMTP_FROM_EMAIL": "",
        "SMTP_USERNAME": ""
      }
    }
  }
}
