{
  "name": "rice-mill-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/web",
    "packages/desktop"
  ],
  "scripts": {
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,green\" \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "dev:web": "npm run dev --workspace=packages/web",
    "dev:desktop": "npm run dev --workspace=packages/desktop",
    "build:web": "npm run build --workspace=packages/web",
    "build:desktop": "npm run build --workspace=packages/desktop",
    "build:shared": "npm run build --workspace=packages/shared",
    "test:web": "npm run test --workspace=packages/web",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --config=playwright.api.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "cf:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "ci:local": "node scripts/ci_local.mjs",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build:web && wrangler deploy"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.3",
    "prettier": "^3.4.2",
    "wrangler": "^4.130.0"
  }
}
